    },
    {
      "name": "4. Mutasi Buku (Bearer Token)",
      "item": [
        {
          "name": "POST buku tanpa token -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/bukus",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"9780132350884\",\n  \"judul\": \"Clean Code\",\n  \"penulis\": \"Robert C. Martin\",\n  \"penerbit\": \"Prentice Hall\",\n  \"tahun_terbit\": 2008,\n  \"kategori_id\": 1,\n  \"stok\": 5,\n  \"sinopsis\": \"Panduan menulis kode bersih.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
