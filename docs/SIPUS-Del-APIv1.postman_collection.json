                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Content-Type problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST buku body kosong -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/bukus",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Content-Type problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"Ada rincian errors\", () => pm.expect(pm.response.json().errors).to.have.property(\"isbn\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST buku valid -> 201 + Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/bukus",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"9780132350884\",\n  \"judul\": \"Clean Code\",\n  \"penulis\": \"Robert C. Martin\",\n  \"penerbit\": \"Prentice Hall\",\n  \"tahun_terbit\": 2008,\n  \"kategori_id\": 1,\n  \"stok\": 5,\n  \"sinopsis\": \"Panduan menulis kode bersih.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Header Location ada\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/bukus/\"));",
                  "pm.collectionVariables.set(\"new_buku_id\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT buku (tanpa sinopsis) -> sinopsis jadi null",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/bukus/{{new_buku_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"9780132350884\",\n  \"judul\": \"Clean Code (Edisi Revisi)\",\n  \"penulis\": \"Robert C. Martin\",\n  \"penerbit\": \"Prentice Hall\",\n  \"tahun_terbit\": 2008,\n  \"kategori_id\": 1,\n  \"stok\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Sinopsis direset ke null (bukti PUT)\", () => pm.expect(pm.response.json().data.sinopsis).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH buku (hanya stok) -> atribut lain utuh",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/bukus/{{new_buku_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stok\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Stok berubah jadi 25\", () => pm.expect(d.stok).to.eql(25));",
                  "pm.test(\"Judul tidak tersentuh (bukti PATCH)\", () => pm.expect(d.judul).to.eql(\"Clean Code (Edisi Revisi)\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH body kosong -> 400",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
