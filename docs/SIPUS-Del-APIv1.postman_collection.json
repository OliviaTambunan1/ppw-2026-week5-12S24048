    {
      "name": "3. Katalog Buku (Publik)",
      "item": [
        {
          "name": "Daftar buku terpaginasi (per_page=3)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/bukus?per_page=3&sort=stok&dir=desc",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Ada blok meta paginasi\", () => pm.expect(j.meta).to.have.property(\"total_items\"));",
                  "pm.test(\"Ada HATEOAS _links\", () => pm.expect(j.data[0]).to.have.property(\"_links\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cari + filter tersedia (search=sql&tersedia=1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/bukus?search=sql&tersedia=1",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
