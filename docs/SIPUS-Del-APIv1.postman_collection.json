{
  "info": {
    "name": "SIPUS-Del API v1 - PPW Week 9",
    "description": "Koleksi pengujian SOAP + REST API SIPUS-Del. Jalankan berurutan setelah `php artisan migrate:fresh --seed`. Folder 1-6 saling berurutan (token dan ID tersimpan otomatis).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_host",
      "value": "http://localhost:8000"
    },
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "buku_stok_nol",
      "value": "21"
    },
    {
      "key": "buku_stok_satu",
      "value": "22"
    },
    {
      "key": "new_buku_id",
      "value": ""
    },
    {
      "key": "peminjaman_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. SOAP - Bebas Pustaka (Legacy)",
      "item": [
        {
          "name": "WSDL - kontrak layanan",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_host}}/soap/sipus.wsdl",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Memuat CheckClearanceStatus\", () => pm.expect(pm.response.text()).to.include(\"CheckClearanceStatus\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "SOAP sukses - NIM punya pinjaman aktif (is_cleared=false)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              }
            ],
            "url": "{{base_host}}/soap/sipus",
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://sipus.del.ac.id/soap/library\">\n  <soap:Body>\n    <m:CheckClearanceStatusRequest>\n      <m:nim_peminjam>12S24001</m:nim_peminjam>\n    </m:CheckClearanceStatusRequest>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is_cleared=false\", () => pm.expect(pm.response.text()).to.include(\"<m:is_cleared>false</m:is_cleared>\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "SOAP sukses - NIM tanpa pinjaman (is_cleared=true)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              }
            ],
            "url": "{{base_host}}/soap/sipus",
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://sipus.del.ac.id/soap/library\">\n  <soap:Body>\n    <m:CheckClearanceStatusRequest>\n      <m:nim_peminjam>12S24003</m:nim_peminjam>\n    </m:CheckClearanceStatusRequest>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is_cleared=true\", () => pm.expect(pm.response.text()).to.include(\"<m:is_cleared>true</m:is_cleared>\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "SOAP Fault - tag nim_peminjam kosong",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              }
            ],
            "url": "{{base_host}}/soap/sipus",
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://sipus.del.ac.id/soap/library\">\n  <soap:Body>\n    <m:CheckClearanceStatusRequest>\n      <m:nim_peminjam></m:nim_peminjam>\n    </m:CheckClearanceStatusRequest>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 500\", () => pm.response.to.have.status(500));",
                  "pm.test(\"Berisi soap:Fault\", () => pm.expect(pm.response.text()).to.include(\"<soap:Fault>\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "SOAP Fault - XML cacat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              }
            ],
            "url": "{{base_host}}/soap/sipus",
            "body": {
              "mode": "raw",
              "raw": "<soap:Envelope><oops>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "auth": {
              "type": "noauth"
